# MongoDB Connection String
# Replace with your Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/syndimatch?retryWrites=true&w=majority

# Server Port
PORT=3001

# Anthropic API (for LangGraph agents - complex reasoning)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API (for reports & summaries - fast generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Coinbase CDP SDK (for real x402 payments)
# Get keys from: https://portal.cdp.coinbase.com/
CDP_API_KEY_NAME=your_cdp_key_name
CDP_API_KEY_PRIVATE_KEY=your_cdp_private_key
CDP_WALLET_DATA=./wallet_seed.json
CDP_NETWORK=base-sepolia  # Use base-sepolia for testnet, base for mainnet

# Platform Configuration
PLATFORM_WALLET=platform-syndimatch-wallet
PLATFORM_FEE_PCT=0.1

# Python Agent Server
AGENT_SERVER_PORT=8000
WS_PORT=8765
